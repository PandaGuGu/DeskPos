<Window x:Class="DeskPos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeskPos"
        Title="DeskPos · 桌面布局" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" ShowInTaskbar="True"
        FontFamily="Microsoft YaHei UI, Segoe UI" TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- ================= 按钮 ================= -->
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#5B7CFF" Offset="0" />
                                    <GradientStop Color="#8F5CFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.32" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="#C6CDDC" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="9" Padding="{TemplateBinding Padding}"
                                Background="#1B1F29" BorderBrush="#2B3140" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#232937" />
                                <Setter TargetName="b" Property="BorderBrush" Value="#3A4356" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Foreground" Value="#E8838C" />
        </Style>

        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="#8B93A7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22283A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinBtnClose" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ================= 统计卡 ================= -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#181B23" />
            <Setter Property="BorderBrush" Value="#252A36" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <!-- ================= 列表行 ================= -->
        <Style x:Key="RowStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" CornerRadius="10" Background="#181B23"
                                BorderBrush="#242935" BorderThickness="1" Padding="14,11">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1D212C" />
                                <Setter TargetName="b" Property="BorderBrush" Value="#2F3646" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1E2740" />
                                <Setter TargetName="b" Property="BorderBrush" Value="#4A6BE0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="32" Height="32" CornerRadius="9" Background="#232B40">
                    <UniformGrid Columns="2" Rows="2" Width="15" Height="15">
                        <Ellipse Margin="1.2" Fill="#7E93D8" />
                        <Ellipse Margin="1.2" Fill="#7E93D8" />
                        <Ellipse Margin="1.2" Fill="#7E93D8" />
                        <Ellipse Margin="1.2" Fill="#C9D4FF" />
                    </UniformGrid>
                </Border>

                <StackPanel Grid.Column="1" Margin="13,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" Foreground="#EBEEF5" FontSize="13"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Meta}" Foreground="#727B90" FontSize="11" Margin="0,3,0,0" />
                </StackPanel>

                <Border Grid.Column="2" Background="#1F2534" CornerRadius="6" Padding="9,3"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding CountText}" Foreground="#8FA0C8" FontSize="11" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ================= 细滚动条 ================= -->
        <Style x:Key="SlimScroll" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="t" CornerRadius="4" Background="#333B4D" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="t" Property="Background" Value="#4C5670" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="14" Background="#101319" BorderBrush="#262B37" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.65" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ 标题栏 ============ -->
            <Grid Grid.Row="0" Height="50" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Image Source="app.ico" Width="24" Height="24"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="DeskPos" Foreground="#F0F2F7" FontSize="14" FontWeight="Bold"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                    <Border Background="#1E2432" CornerRadius="6" Padding="8,2" Margin="9,1,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="桌面布局" Foreground="#7E88A0" FontSize="10.5" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <Button Style="{StaticResource WinBtn}" Content="—" Click="Min_Click" />
                    <Button Style="{StaticResource WinBtnClose}" Content="✕" Click="Close_Click"
                            Margin="2,0,0,0" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="0" Height="1" Background="#1C202A" VerticalAlignment="Bottom" />

            <!-- ============ 主体 ============ -->
            <Grid Grid.Row="1" Margin="22,2,22,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 统计 -->
                <UniformGrid Grid.Row="0" Columns="3">
                    <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5" Height="5" Fill="#5B7CFF" VerticalAlignment="Center" />
                                <TextBlock Text="桌面图标" Foreground="#7B8499" FontSize="11" Margin="7,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="StatIcons" Text="—" Foreground="#F0F2F7" FontSize="21"
                                       FontFamily="Segoe UI" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="DotArrange" Width="5" Height="5" Fill="#3DDC97"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="自动排列" Foreground="#7B8499" FontSize="11" Margin="7,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="StatArrange" Text="—" Foreground="#F0F2F7" FontSize="21"
                                       FontFamily="Segoe UI" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5" Height="5" Fill="#8F5CFF" VerticalAlignment="Center" />
                                <TextBlock Text="屏幕分辨率" Foreground="#7B8499" FontSize="11" Margin="7,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="StatScreen" Text="—" Foreground="#F0F2F7" FontSize="21"
                                       FontFamily="Segoe UI" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 区块标题 -->
                <Grid Grid.Row="1" Margin="2,20,2,10">
                    <TextBlock Text="已保存的布局" Foreground="#DCE1EC" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button x:Name="BtnSave" Style="{StaticResource Primary}" Content="＋  保存当前布局"
                            HorizontalAlignment="Right" Click="Save_Click" />
                </Grid>

                <!-- 列表 + 预览 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,18,0">
                        <ListBox x:Name="LayoutList" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource RowStyle}"
                                 ItemTemplate="{StaticResource RowTemplate}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="LayoutList_SelectionChanged"
                                 MouseDoubleClick="LayoutList_DoubleClick"
                                 Padding="0,0,4,0">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScroll}" />
                            </ListBox.Resources>
                        </ListBox>

                        <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="Collapsed">
                            <Border Width="54" Height="54" CornerRadius="16" Background="#171B23"
                                    BorderBrush="#242935" BorderThickness="1" HorizontalAlignment="Center">
                                <UniformGrid Columns="2" Rows="2" Width="24" Height="24">
                                    <Ellipse Margin="2" Fill="#39425A" />
                                    <Ellipse Margin="2" Fill="#39425A" />
                                    <Ellipse Margin="2" Fill="#39425A" />
                                    <Ellipse Margin="2" Fill="#6E82B8" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="还没有保存任何布局" Foreground="#6E778C" FontSize="12.5"
                                       HorizontalAlignment="Center" Margin="0,14,0,0" />
                            <TextBlock Text="点右上角保存一次，之后随时可以还原" Foreground="#4E5668"
                                       FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- ================= 预览面板 ================= -->
                    <Border Grid.Column="1" Width="600" Background="#12151C" BorderBrush="#242935"
                            BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="14,11,14,9">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="5" Height="5" Fill="#5B7CFF" VerticalAlignment="Center" />
                                    <TextBlock Text="布局预览" Foreground="#8D97AC" FontSize="11.5" Margin="7,0,0,0" />
                                    <TextBlock x:Name="PreviewTitle" Text="" Foreground="#E6EAF2" FontSize="11.5"
                                               FontWeight="SemiBold" Margin="8,0,0,0"
                                               TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                </StackPanel>
                                <TextBlock x:Name="PreviewMeta" Text="" Foreground="#5A6478" FontSize="10.5"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="12,0,12,0">
                                <local:DeskPreview x:Name="Preview" Margin="0" />

                                <StackPanel x:Name="PreviewEmpty" VerticalAlignment="Center"
                                            HorizontalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="选中左侧任一布局" Foreground="#5F6879" FontSize="11.5"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="这里会按保存时的坐标把桌面缩小画出来" Foreground="#434B5C"
                                               FontSize="10.5" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2" Margin="14,8,14,10">
                                <TextBlock x:Name="PreviewHover" Text="悬停图标可查看名称"
                                           Foreground="#6B7488" FontSize="10.5" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Button x:Name="BtnGhost" Content="叠加当前位置" Click="Ghost_Click"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Foreground="#8A93A8" FontSize="10.5" Padding="10,3"
                                        Cursor="Hand" Background="#171B23" BorderBrush="#2B3140"
                                        BorderThickness="1" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 操作区 -->
                <Grid Grid.Row="3" Margin="0,14,0,14">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnRestore" Style="{StaticResource Primary}" Content="↺  恢复选中布局"
                                Click="Restore_Click" IsEnabled="False" />
                        <Button x:Name="BtnDiff" Style="{StaticResource Ghost}" Content="预览差异"
                                Margin="10,0,0,0" Click="Diff_Click" IsEnabled="False" />
                        <Button x:Name="BtnDelete" Style="{StaticResource Danger}" Content="删除"
                                Margin="10,0,0,0" Click="Delete_Click" IsEnabled="False" />
                    </StackPanel>
                    <TextBlock x:Name="HintText" Text="双击列表项可直接恢复"
                               Foreground="#4E5668" FontSize="11" VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>
            </Grid>

            <!-- ============ 状态栏 ============ -->
            <Border Grid.Row="2" Height="36" BorderBrush="#1E222C" BorderThickness="0,1,0,0"
                    Background="#0D1015" CornerRadius="0,0,14,14">
                <Grid Margin="18,0">
                    <TextBlock x:Name="StatusText" Text="就绪" Foreground="#68718A" FontSize="11"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="BtnFolder" Content="布局目录" Foreground="#5B7CFF" FontSize="11"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="Folder_Click" />
                </Grid>
            </Border>

            <!-- ============ Toast ============ -->
            <Border x:Name="Toast" Grid.RowSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Margin="0,0,24,48" Background="#232937" BorderBrush="#3A4356" BorderThickness="1"
                    CornerRadius="10" Padding="18,10" Opacity="0" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45" Color="#000000" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastShift" Y="14" />
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ToastDot" Width="6" Height="6" Fill="#3DDC97"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="ToastText" Foreground="#E9EDF5" FontSize="12" Margin="10,0,0,0" />
                </StackPanel>
            </Border>

            <!-- ============ 输入 / 确认遮罩 ============ -->
            <Grid x:Name="Mask" Grid.RowSpan="3" Background="#C2070910" Visibility="Collapsed"
                  MouseLeftButtonDown="Mask_Click">
                <Border x:Name="Dialog" Width="380" CornerRadius="14" Background="#161A22"
                        BorderBrush="#2C3242" BorderThickness="1" Padding="22,20"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.6" Color="#000000" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="DlgTitle" Text="保存当前布局" Foreground="#F0F2F7"
                                   FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="DlgDesc" Text="给这份布局起个名字，方便以后切换。"
                                   Foreground="#727B90" FontSize="11.5" Margin="0,6,0,0" />
                        <Border x:Name="InputWrap" Background="#101319" BorderBrush="#2C3342"
                                BorderThickness="1" CornerRadius="9" Margin="0,14,0,0" Padding="12,0">
                            <TextBox x:Name="NameBox" Background="Transparent" BorderThickness="0"
                                     Foreground="#EDEFF4" FontSize="13" Height="38"
                                     VerticalContentAlignment="Center" CaretBrush="#5B7CFF"
                                     KeyDown="NameBox_KeyDown" />
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                            <Button Style="{StaticResource Ghost}" Content="取消" Padding="18,8"
                                    Click="DlgCancel_Click" />
                            <Button x:Name="DlgOk" Style="{StaticResource Primary}" Content="确定"
                                    Padding="22,8" Margin="10,0,0,0" Click="DlgOk_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
